# Copie este arquivo para ".env" e preencha com seus valores reais.
# O ".env" nunca deve ser enviado para o Git (veja .gitignore).

# Chave secreta do Django (troque por qualquer texto aleatório)
SECRET_KEY=troque-esta-chave-por-um-texto-aleatorio-e-secreto

# True em desenvolvimento, False em produção
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE=postgresql  -> usa PostgreSQL (padrão da disciplina)
# DB_ENGINE=sqlite3     -> usa SQLite (não precisa instalar nada, ótimo para testar rápido)
DB_ENGINE=postgresql

DB_NAME=portal_noticias_db
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_HOST=localhost
DB_PORT=5432
